{
  // Ask VNXT. The site posts here from assets/ask-vnxt.js (ASK_VNXT_API).
  // Live chat URL (ASK_VNXT_API): https://vnxt-gemini.tss-receivables.workers.dev
  // vnxt-gemini serves Ask VNXT and CRM voice. This package is the vnxt-ask prompt source.
  //
  // Secret (do not commit a key):
  //   npx wrangler secret put GEMINI_API_KEY
  // Then:
  //   npx wrangler deploy
  // GEMINI_MODEL is not secret. Default is gemini-flash-latest. Change it here to pin another model.
  "name": "vnxt-ask",
  "main": "src/index.js",
  "compatibility_date": "2026-11-02",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    "GEMINI_MODEL": "gemini-flash-latest"
  }
}
